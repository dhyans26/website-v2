---
import { readFileSync, existsSync } from 'fs';
import { parse } from 'yaml';

const logos = parse(readFileSync('src/content/tech.yaml', 'utf-8')) as {
    name: string; slug: string; color: string; href: string;
}[];

// Icons are generated into public/tech/ by scripts/build-tech-icons.mjs
// (npm run tech-icons, wired to prebuild/predev). Anything simple-icons
// doesn't carry — Java, which was pulled over Oracle's trademark — has no
// file and falls back to a text pill instead of a broken image.
const track = [...logos, ...logos].map((logo) => ({
    ...logo,
    icon: existsSync(`public/tech/${logo.slug}.svg`) ? `/tech/${logo.slug}.svg` : null,
}));
---

<section class="marquee">
    <header class="head container">
        <h2>tools i've used</h2>
    </header>

    <div class="logos">
        <div class="track">
            {track.map((logo) => (
                <a href={logo.href} target="_blank" rel="noopener noreferrer" aria-label={logo.name}>
                    {logo.icon
                        ? <img src={logo.icon} alt={logo.name} loading="lazy" width="40" height="40" />
                        : <span class="logo-fallback mono" style={`color: #${logo.color}`}>{logo.name}</span>}
                </a>
            ))}
        </div>
    </div>
</section>

<style lang="scss">
    .marquee {
        padding: 2rem 0 4rem;
    }

    .head {
        padding: 0 1.5rem;
        margin-bottom: 2rem;

        h2 {
            color: var(--text);
            font-size: clamp(1.75rem, 3.5vw, 2.25rem);
            font-weight: 700;
        }
    }

    @keyframes slide {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    .logos {
        overflow: hidden;
        position: relative;
        padding: 2rem 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: var(--surface);
        mask-image: linear-gradient(
            to right,
            transparent,
            #000 10%,
            #000 90%,
            transparent
        );
        -webkit-mask-image: linear-gradient(
            to right,
            transparent,
            #000 10%,
            #000 90%,
            transparent
        );

        &:hover .track {
            animation-play-state: paused;
        }
    }

    .track {
        display: flex;
        gap: 3.5rem;
        width: max-content;
        animation: slide 80s linear infinite;

        a {
            display: flex;
            align-items: center;
            opacity: 0.65;
            transition: opacity 0.25s ease, transform 0.25s ease;

            &:hover {
                opacity: 1;
                transform: scale(1.15);
            }
        }

        img {
            height: 2.5rem;
            width: 2.5rem; // simple-icons are square; reserve the box so the
            object-fit: contain; // track doesn't reflow as lazy icons arrive
        }

        // stands in for any tech with no simple-icons entry
        .logo-fallback {
            display: flex;
            align-items: center;
            height: 2.5rem;
            padding: 0 0.85rem;
            border: 1px solid currentColor;
            border-radius: 0.6rem;
            font-size: 0.9rem;
            font-weight: 500;
            white-space: nowrap;
        }
    }
</style>

---
import { readFileSync, existsSync } from 'fs';
import { parse } from 'yaml';

const logos = parse(readFileSync('src/content/tech.yaml', 'utf-8')) as {
    name: string; slug: string; color: string; href: string;
}[];

// Icons are generated into public/tech/ by scripts/build-tech-icons.mjs
// (wired to prebuild/predev via astro.config.mjs). Anything simple-icons
// doesn't carry — Java, pulled over Oracle's trademark — has no file and
// falls back to a text pill instead of a broken image.
const items = logos.map((logo) => ({
    ...logo,
    icon: existsSync(`public/tech/${logo.slug}.svg`) ? `/tech/${logo.slug}.svg` : null,
}));

// Two rows drifting in opposite directions. Interleaving by index rather
// than slicing in half keeps each row a mix of categories — a split would
// put every language in row one and every host in row two.
const rows = [
    items.filter((_, i) => i % 2 === 0),
    items.filter((_, i) => i % 2 === 1),
];

// Each row is its own length, so a shared duration would make the shorter
// row visibly faster. Deriving it per row from the item count holds the
// scroll speed constant no matter how tech.yaml grows or shrinks.
const SECONDS_PER_ITEM = 2.4;
---

<section class="marquee">
    <header class="head container">
        <h2>tools i've used</h2>
    </header>

    <div class="rows">
        {rows.map((row, r) => (
            <div class="row">
                <div class="track" style={`--dur: ${(row.length * SECONDS_PER_ITEM).toFixed(1)}s`} data-dir={r % 2 === 0 ? 'ltr' : 'rtl'}>
                    {/* The track is rendered twice back-to-back and slid by exactly
                        -50%, which is what makes the loop seamless. The second copy
                        is decorative: hidden from assistive tech and taken out of the
                        tab order so the row isn't 2x links to a screen reader. */}
                    {[false, true].map((isClone) => row.map((logo) => (
                        <a
                            class="item"
                            href={logo.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={isClone ? undefined : logo.name}
                            aria-hidden={isClone ? 'true' : undefined}
                            tabindex={isClone ? -1 : undefined}
                        >
                            {logo.icon
                                ? <img
                                      class="glyph"
                                      src={logo.icon}
                                      alt=""
                                      width="40"
                                      height="40"
                                      decoding="async"
                                      fetchpriority="low"
                                  />
                                : <span class="glyph fallback mono" style={`color: #${logo.color}`}>{logo.name}</span>}
                        </a>
                    )))}
                </div>
            </div>
        ))}
    </div>
</section>

<style lang="scss">
    .marquee {
        padding: 2rem 0 4rem;
    }

    .head {
        margin-bottom: 2rem;

        h2 {
            color: var(--text);
            // matches the "things i've built" heading on the home page
            font-size: clamp(2rem, 4vw, 2.75rem);
            font-weight: 700;
        }
    }

    .rows {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 2.25rem 0;
        border-top: 1px solid var(--border);
        border-bottom: 1px solid var(--border);
        background: var(--surface);
    }

    .row {
        overflow: hidden;
        // breathing room so the hover lift/scale isn't clipped by the row
        padding: 0.4rem 0;
        mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
        -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);

        // pause only the row being pointed at — the other keeps drifting, so
        // the section still feels alive while you read one icon
        &:hover .track,
        &:focus-within .track {
            animation-play-state: paused;
        }
    }

    @keyframes slide {
        from { transform: translate3d(0, 0, 0); }
        to   { transform: translate3d(-50%, 0, 0); }
    }

    .track {
        display: flex;
        width: max-content;
        animation: slide var(--dur) linear infinite;
        will-change: transform;

        // NOTE: spacing lives in each item's padding, NOT in a flex `gap`.
        // With `gap`, the track measures 2*items + (2n-1)*gaps, so -50% lands
        // half a gap short of a whole copy and the loop jumps every cycle.
        // Folding the spacing into the items makes -50% exactly one copy.
        &[data-dir='rtl'] {
            animation-direction: reverse;
        }
    }

    .item {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 1.75rem;
        height: 2.5rem;

        .glyph {
            // resting state keeps most of the brand colour but sits back;
            // hover brings it fully forward
            filter: grayscale(0.45);
            opacity: 0.6;
            transition: opacity 0.25s ease, filter 0.25s ease, transform 0.25s ease;
        }

        &:hover .glyph,
        &:focus-visible .glyph {
            filter: none;
            opacity: 1;
            transform: translateY(-3px) scale(1.12);
        }
    }

    img.glyph {
        height: 2.5rem;
        width: 2.5rem; // simple-icons are square; reserve the box so the
        object-fit: contain; // track doesn't reflow as icons arrive
    }

    // stands in for any tech with no simple-icons entry
    .fallback {
        display: flex;
        align-items: center;
        height: 2.5rem;
        padding: 0 0.85rem;
        border: 1px solid currentColor;
        border-radius: 0.6rem;
        font-size: 0.9rem;
        font-weight: 500;
        white-space: nowrap;
    }

    @media (max-width: 640px) {
        .item { padding: 0 1.1rem; }
    }

    // A permanently-moving strip is the exact thing this setting exists to
    // stop. Park both rows and let them be scrolled by hand instead.
    @media (prefers-reduced-motion: reduce) {
        .track {
            animation: none;
            // the clone half is unreachable and redundant once nothing moves
            width: auto;
        }

        .row {
            overflow-x: auto;
            scrollbar-width: none;

            &::-webkit-scrollbar { display: none; }
        }

        .item .glyph { transition: none; }

        .item[aria-hidden='true'] { display: none; }
    }
</style>

---
import '../styles/globals.scss';
// self-hosted fonts — no CDN round-trips
import '@fontsource-variable/space-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
// self-hosted icons
import 'bootstrap-icons/font/bootstrap-icons.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import ProjectModal from '../components/ProjectModal.astro';
import StarField from '../components/StarField.astro';
import { ClientRouter } from 'astro:transitions';
import { INFO } from '../consts';
import { readFileSync } from 'fs';
import { parse } from 'yaml';

interface Props {
    pageTitle: string;
    description?: string;
    ogImage?: string;
}

const { pageTitle, description, ogImage } = Astro.props;

const SITE_DESCRIPTION = `${INFO.name} — ${INFO.education} ${INFO.gradeLevel} from the ${INFO.location} area and a software engineer @ The Hack Foundation. Sports, aerospace, and engineering.`;
const desc = description ?? SITE_DESCRIPTION;
const fullTitle = `Dhyan: ${pageTitle}`;

// Canonical + absolute OG URLs (Astro.site comes from astro.config `site`).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage ?? '/pfp/dhyan.webp', Astro.site).href;

const personLd = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: INFO.name,
    url: Astro.site?.href,
    email: `mailto:${INFO.email}`,
    sameAs: [`https://github.com/${INFO.github}`],
};

const accentConfig: Record<string, number> = parse(readFileSync('src/content/accent.yaml', 'utf-8')) ?? {};
const accentNames = JSON.stringify(Object.keys(accentConfig));
const accentWeights = JSON.stringify(Object.values(accentConfig));
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/x-icon" href="/favicon.ico" />

        <meta name="generator" content={Astro.generator} />
        <title>{fullTitle}</title>

        <!-- SEO -->
        <meta name="description" content={desc} />
        <meta name="author" content={INFO.name} />
        <link rel="canonical" href={canonical} />
        <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
        <link rel="alternate" type="application/rss+xml" title={`${INFO.name} — Blog`} href="/rss.xml" />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={INFO.site} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={desc} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={ogImageUrl} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={desc} />
        <meta name="twitter:image" content={ogImageUrl} />

        <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />

        <!-- Smooth client-side navigation -->
        <ClientRouter />

        <script is:inline define:vars={{ accentNames, accentWeights }}>
            (function(){var p=sessionStorage.getItem('accent');if(!p){var a=JSON.parse(accentNames),w=JSON.parse(accentWeights),t=0,i,c=0;for(i=0;i<w.length;i++)t+=w[i];var r=Math.random()*t;p=a[0];for(i=0;i<a.length;i++){c+=w[i];if(r<c){p=a[i];break;}}sessionStorage.setItem('accent',p);}document.documentElement.dataset.accent=p;})();
        </script>
    </head>

    <body>
        <StarField transition:persist />
        <Navigation transition:persist />
        <main>
            <slot />
        </main>
        <Footer transition:persist />
        <ProjectModal transition:persist />
    </body>
</html>

<style is:global>
    main {
        min-height: calc(100vh - 14rem);
    }
</style>

# Cloudflare Web Analytics beacon token.
# Get it from: Cloudflare dashboard -> Analytics & Logs -> Web Analytics ->
# add dhyans.dev -> copy the `token` value out of the snippet it shows you.
#
# Only used in production builds (`npm run build`); `npm run dev` never sends
# beacons, so local browsing stays out of the stats. Leave it unset and the
# script simply isn't emitted.
PUBLIC_CF_BEACON_TOKEN=

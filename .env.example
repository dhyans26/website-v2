# Cloudflare Web Analytics beacon token.
# Get it from: Cloudflare dashboard -> Analytics & Logs -> Web Analytics ->
# add dhyans.dev -> copy the `token` value out of the snippet it shows you.
#
# Only used in production builds (`npm run build`); `npm run dev` never sends
# beacons, so local browsing stays out of the stats. Leave it unset and the
# script simply isn't emitted.
PUBLIC_CF_BEACON_TOKEN=

# Optional. A classic PAT with NO scopes (public data only) is enough.
# Purely a rate-limit lever for the build: GitHub allows 60 requests/hour per IP
# unauthenticated, 5000/hour with a token. The site builds fine without it —
# a rate-limited build falls back to the last cached data.
# Deliberately NOT prefixed with PUBLIC_, so it never reaches the browser.
GITHUB_TOKEN=
